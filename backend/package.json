{
  "name": "skindex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:supabase": "node --env-file-if-exists=.env --import tsx src/check-supabase.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
