# Copy to .env for local development. Every value has a local default except the ones you add.

# --- Database ---
# Local: leave unset to use SQLite (local.db), or point at Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skindex
# Supabase: Project > Connect > Session pooler URI (works from Render, IPv4)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...        # server only, never in the app
# SUPABASE_JWT_SECRET=                     # only for legacy HS256 projects, or local dev tokens

# --- Photos ---
# STORAGE_BACKEND=local                    # "supabase" is chosen automatically when the two Supabase values are set
# STORAGE_BUCKET=checkin-photos
# PUBLIC_BASE_URL=http://localhost:8000    # used for local photo links; use your LAN IP to test on a phone

# --- Skin model ---
# MODEL_DIR=models/dev                     # folder with model.onnx + model.json

# --- Other ---
# ADMIN_USER_IDS=                          # Supabase user ids allowed to export training data
# CORS_ORIGINS=http://localhost:8081       # Expo web dev server
# SKINDEX_ENV=development
